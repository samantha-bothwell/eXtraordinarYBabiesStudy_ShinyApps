geom_smooth(data = lms_recep, aes(x = age, y = P10)) +
geom_smooth(data = lms_recep, aes(x = age, y = P25)) +
geom_smooth(data = lms_recep, aes(x = age, y = P50)) +
geom_smooth(data = lms_recep, aes(x = age, y = P75)) +
geom_smooth(data = lms_recep, aes(x = age, y = P90)) +
labs(title = str_wrap("GAMLSS Plot: Receptive Bayley 4 Scores versus Age in Months; Percentile Curves", width = 50),
y = "Bayley 4 Score", x = "Age in Months")
ggsave("receptive.jpg", plot = recepplot, width = 6, height = 4,
dpi = 300)
