geom_point() +
geom_smooth(data = lms_exp, aes(x = age, y = P5)) +
geom_smooth(data = lms_exp, aes(x = age, y = P10)) +
geom_smooth(data = lms_exp, aes(x = age, y = P25)) +
geom_smooth(data = lms_exp, aes(x = age, y = P50)) +
geom_smooth(data = lms_exp, aes(x = age, y = P75)) +
geom_smooth(data = lms_exp, aes(x = age, y = P90)) +
geom_smooth(data = lms_exp, aes(x = age, y = P95)) + labs(title = str_wrap("GAMLSS Plot: Expressive Bayley 4 Scores versus Age in Months; Percentile Curves", width = 50),
y = "Bayley 4 Score", x = "Age in Months")
ggsave("expressive.jpg", plot = expplot, width = 6, height = 4,
dpi = 300)
#doing these steps over for the fine motor scores
gsv_nona_fmo <- gsvscores.05 %>%
filter(!is.na(bsid_age_calc)) %>%
filter(variable == "finemotor") %>%
filter(!is.na(value2)) %>%
