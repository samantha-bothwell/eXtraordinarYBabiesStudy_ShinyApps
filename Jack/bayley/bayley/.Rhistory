family = BCCG()
)
# 3. Get predicted distribution parameters from the model
paramsexp <- predictAll(gamlss_exp, newdata = newdata)
# 4. Calculate centiles manually using the BCCG distribution quantile function
centilesexp <- c(5, 10, 25, 50, 75, 90, 95)
q_valsexp <- sapply(centilesexp / 100, function(p) {
qBCCG(p, mu = paramsexp$mu, sigma = paramsexp$sigma, nu = paramsexp$nu)
})
# 5. Create a dataframe of predicted centiles
lms_exp <- data.frame(age = ages, q_valsexp)
colnames(lms_exp)[-1] <- paste0("P", centilesexp)
# Plot it
