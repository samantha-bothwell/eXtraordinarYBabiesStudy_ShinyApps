geom_smooth(data = lms_fmo, aes(x = age, y = P95)) + labs(title = str_wrap("GAMLSS Plot: Fine Motor Bayley 4 Scores\nversus Age in Months; Percentile Curves", width = 50),
y = "Bayley 4 Score", x = "Age in Months")
