library(ggplot2)
library(knitr)
library(dplyr)
library(gridExtra)
library(vtable)
library(gtsummary) # elegant and flexible way to create publication-ready analytically and summary tables
library(ResourceSelection)
theme_gtsummary_compact() # set gtsummary theme
heart_disease = read.csv("heart_disease.csv", header = TRUE)
heart_disease$CDH <- as.factor(heart_disease$CDH)
heart_disease$SMK <- as.factor(heart_disease$SMK)
heart_disease$CAT <- as.factor(heart_disease$CAT)
heart_disease$ECG <- as.factor(heart_disease$ECG)
heart_disease$HPT <- as.factor(heart_disease$HPT)
heart_disease = heart_disease %>%
mutate(AGE_GRP = case_when(
AGE >= 40 & AGE <= 50 ~ "40-50",
AGE > 50 & AGE <= 60 ~ "50-60",
AGE > 60 & AGE <= 70 ~ "60-70",
AGE > 70 ~ "70+",
TRUE ~ NA_character_
))
head(heart_disease, n = 50) %>%
kable %>%
kable_styling("striped", full_width = F) %>%
scroll_box(height = "200px")
heart_disease %>%
tbl_summary(type = all_continuous() ~ "continuous2",
statistic = list(all_continuous() ~ c("({min}, {max})", "{mean} ({sd})", "{median} ({p25}, {p75})"),
all_categorical() ~ "{n} ({p}%)"))
heart_disease$CDH_YN = ifelse(heart_disease$CDH == 1, "Yes", "No")
HD_plot1 <- ggplot(heart_disease, aes(x = CDH_YN, y = CHL)) +
geom_boxplot(fill = "cornflowerblue") +
xlab("Coronary Heart Disease") +
theme_minimal()
HD_plot2 <- ggplot(heart_disease, aes(y = CDH_YN, x = CHL)) +
geom_point() +
ylab("Coronary Heart Disease") +
theme_minimal()
HD_plot3 <- ggplot(heart_disease, aes(y = CDH_YN, x = CHL, fill = CDH_YN)) +
geom_jitter(aes(colour = CDH_YN)) +
theme_minimal() +
ylab("Coronary Heart Disease") +
theme(legend.position="bottom", legend.title=element_blank())
HD_plot4 <- ggplot(heart_disease, aes(x = CHL, fill = CDH_YN)) +
geom_density(alpha = 0.4) +
theme_minimal() +
theme(legend.position="bottom", legend.title=element_blank())
grid.arrange(HD_plot1, HD_plot4, HD_plot2, HD_plot3,  ncol=2)
model1 <- glm(CDH ~ CHL, data = heart_disease, family = binomial(link = "logit"))
summary(model1)
exp(coef(model1))
exp(confint(model1))
model1 %>%
tbl_regression(exponentiate = TRUE) %>%
add_glance_table(include = c(AIC, deviance))
HD_barploat1 <- ggplot(heart_disease, aes(x = CDH, fill = SMK)) +
geom_bar(position = "fill") +
scale_y_continuous(breaks = seq(0, 1, .2), labels = scales::percent) +
labs(x = "Coronary Heart Disease", y = "Percent") +
scale_fill_brewer(palette = "Set2") +
theme_minimal() +
theme(legend.position="bottom")
HD_barploat2 <- ggplot(heart_disease, aes(x = CDH, fill = AGE_GRP)) +
geom_bar(position = "fill") +
scale_y_continuous(breaks = seq(0, 1, .2), labels = scales::percent) +
labs(x = "Coronary Heart Disease", y = "Percent") +
scale_fill_brewer(palette = "Set2") +
theme_minimal() +
theme(legend.position="bottom")
grid.arrange(HD_barploat1, HD_barploat2,  ncol=2)
model2 <- glm(CDH ~ CHL + AGE_GRP + SMK, data = heart_disease, family = binomial(link = "logit"))
summary(model2)
model2 %>% tbl_regression(exponentiate = TRUE) %>% add_glance_table(include = c(AIC, deviance))
library(car)
Anova(model2, type = 3)
model3 <- glm(CDH ~ CHL + AGE_GRP + SMK + ECG + SBP, data = heart_disease, family = binomial(link = "logit"))
summary(model3)
model3 %>% tbl_regression(exponentiate = TRUE) %>%
add_glance_table(include = c(AIC, deviance))
pchisq(8, df = 2, lower.tail = FALSE)
model_all <- glm(CDH ~ CHL + AGE + SMK + ECG + SBP + DBP + SBP + HPT + CAT, data = heart_disease, family = binomial(link = "logit"))
summary(model_all)
model_all %>% tbl_regression(exponentiate = TRUE) %>%
add_glance_table(include = c(AIC, deviance))
library(ggplot2) # Create Elegant Data Visualisations Using the Grammar of Graphics
library(knitr) # A General-Purpose Package for Dynamic Report Generation in R
library(dplyr) # A Grammar of Data Manipulation
library(gridExtra) # Miscellaneous Functions for "Grid" Graphics
library(vtable) # Variable Table for Variable Documentation
library(DT) # A Wrapper of the JavaScript Library 'DataTables'
library(gtsummary) # elegant and flexible way to create publication-ready analytically and summary tables
theme_gtsummary_compact() # set gtsummary theme
# Remeber to change your directory
#setwd("C:/Users/lunz/OneDrive - The University of Colorado Denver/Documents/Teaching/COSIB2025")
# Import the heart disease dataset
heart_disease = read.csv("heart_disease.csv", header = TRUE)
# Convert the following variables in the heart_disease dataset to a factor (categorical variable)
heart_disease$CDH <- as.factor(heart_disease$CDH)
heart_disease$SMK <- as.factor(heart_disease$SMK)
heart_disease$CAT <- as.factor(heart_disease$CAT)
heart_disease$ECG <- as.factor(heart_disease$ECG)
heart_disease$HPT <- as.factor(heart_disease$HPT)
# Create a new variable for age group: AGE_GRP
heart_disease = heart_disease %>%
mutate(AGE_GRP = case_when(
AGE >= 40 & AGE <= 50 ~ "40-50",
AGE > 50 & AGE <= 60 ~ "50-60",
AGE > 60 & AGE <= 70 ~ "60-70",
AGE > 70 ~ "70+",
TRUE ~ NA_character_
))
# Print first 50 rows
datatable(head(heart_disease, n = 50))
# Output data summary
heart_disease %>%
tbl_summary(
by = CDH,
type = all_continuous() ~ "continuous2",
statistic = list(all_continuous() ~ c("({min}, {max})", "{mean} ({sd})", "{median} ({p25}, {p75})"),
all_categorical() ~ "{n} ({p}%)")) %>%
add_overall() %>% # Add overall column
add_p() %>% # Add p-values
modify_spanning_header(all_stat_cols() ~ "**Coronary Heart Disease**")
heart_disease$CDH_YN = ifelse(heart_disease$CDH == 1, "Yes", "No")
HD_plot1 <- ggplot(heart_disease, aes(x = CDH_YN, y = CHL, fill = CDH_YN)) +
geom_boxplot() +
xlab("Coronary Heart Disease") +
theme_minimal()
HD_plot2 <- ggplot(heart_disease, aes(y = CDH_YN, x = CHL)) +
geom_point() +
ylab("Coronary Heart Disease") +
theme_minimal()
HD_plot3 <- ggplot(heart_disease, aes(y = CDH_YN, x = CHL, fill = CDH_YN)) +
geom_jitter(aes(colour = CDH_YN)) +
theme_minimal() +
ylab("Coronary Heart Disease") +
theme(legend.position="bottom", legend.title=element_blank())
HD_plot4 <- ggplot(heart_disease, aes(x = CHL, fill = CDH_YN)) +
geom_density(alpha = 0.4) +
theme_minimal() +
theme(legend.position="bottom", legend.title=element_blank())
grid.arrange(HD_plot1, HD_plot4, HD_plot2, HD_plot3,  ncol=2)
model1 <- glm(CDH ~ CHL, data = heart_disease, family = binomial(link = "logit"))
summary(model1)
exp(coef(model1))
exp(confint(model1))
model1 %>%
tbl_regression(exponentiate = TRUE) %>%
add_glance_table(include = c(AIC, deviance)) # AIC and deviance added for model assessment
HD_barploat1 <- ggplot(heart_disease, aes(x = CDH, fill = SMK)) +
geom_bar(position = "fill") +
scale_y_continuous(breaks = seq(0, 1, .2), labels = scales::percent) +
labs(x = "Coronary Heart Disease", y = "Percent") +
scale_fill_brewer(palette = "Set2") +
theme_minimal() +
theme(legend.position="bottom")
HD_barploat2 <- ggplot(heart_disease, aes(x = CDH, fill = AGE_GRP)) +
geom_bar(position = "fill") +
scale_y_continuous(breaks = seq(0, 1, .2), labels = scales::percent) +
labs(x = "Coronary Heart Disease", y = "Percent") +
scale_fill_brewer(palette = "Set2") +
theme_minimal() +
theme(legend.position="bottom")
grid.arrange(HD_barploat1, HD_barploat2,  ncol=2)
model2 <- glm(CDH ~ CHL + AGE_GRP + SMK, data = heart_disease, family = binomial(link = "logit"))
summary(model2)
model2 %>% tbl_regression(exponentiate = TRUE) %>% add_glance_table(include = c(AIC, deviance))
library(car) # Companion to Applied Regression
Anova(model2, type = 3)
model3 <- glm(CDH ~ CHL + AGE_GRP + SMK + ECG + SBP, data = heart_disease, family = binomial(link = "logit"))
summary(model3)
model3 %>% tbl_regression(exponentiate = TRUE) %>%
add_glance_table(include = c(AIC, deviance))
# Calculate the p-value from a chi-square distribution
# This gives the probability of observing a chi-square statistic of 8 or more
# under the null hypothesis, with 2 degrees of freedom
pchisq(8, df = 2, lower.tail = FALSE)
# Load library
library(MASS) # Support Functions and Datasets for Venables and Ripley's MASS
# Fit full logistic model
heart_disease2 = heart_disease %>% dplyr::select(-c(AGE, CDH_YN)) # remove the continuous AGE as we created AGE_GRP
full_model <- glm(CDH ~ ., data = heart_disease2, family = binomial)
# Stepwise selection
step_model <- MASS::stepAIC(full_model, direction = "both")
# Summary of selected model
summary(step_model)
model_int <- glm(CDH ~ SMK*ECG, data = heart_disease, family = binomial(link = "logit"))
summary(model_int)
model_int %>% tbl_regression(exponentiate = TRUE) %>%
add_glance_table(include = c(AIC, deviance))
# Fit full logistic model with interaction
full_model <- glm(CDH ~ (.)^2, data = heart_disease2, family = binomial)
# Stepwise selection
step_model <- MASS::stepAIC(full_model, direction = "both", trace = FALSE) # not to print its step-by-step progress
# Summary of selected model
summary(step_model)
library(ResourceSelection)
best_model <- glm(CDH ~ CAT + CHL + SMK + HPT + AGE_GRP, data = heart_disease, family = binomial(link = "logit"))
# as.numeric() to ensure 0/1 values:
hoslem.test(as.numeric(heart_disease$CDH), fitted(best_model), g = 10)
# Add the predicted probabilities to the dataset
heart_disease$predicted_prob <- round(predict(best_model, type = "response"), digits = 4)
datatable(head(heart_disease[, c("CDH", "CAT", "CHL", "SMK", "HPT", "AGE_GRP", "predicted_prob")], n = 50))
heart_disease$predicted_CDH <- as.factor(ifelse(heart_disease$predicted_prob >= 0.5, 1, 0))
datatable(head(heart_disease[, c("CDH", "CDH", "CAT", "CHL", "SMK", "HPT", "AGE_GRP","predicted_prob", "predicted_CDH")], n = 50))
heart_disease$predicted_CDH <- as.factor(ifelse(heart_disease$predicted_prob >= 0.5, 1, 0))
tbl <- table(heart_disease$CDH, heart_disease$predicted_CDH)
dimnames(tbl) <- list("Actual CDH" = levels(heart_disease$CDH),
"Predicted CDH" = levels(heart_disease$predicted_CDH))
tbl
# Modify the cut-off point = 0.025:
heart_disease$predicted_CDH <- as.factor(ifelse(heart_disease$predicted_prob >= 0.025, 1, 0))
tbl <- table(heart_disease$CDH, heart_disease$predicted_CDH)
dimnames(tbl) <- list("Actual CDH" = levels(heart_disease$CDH),
"Predicted CDH" = levels(heart_disease$predicted_CDH))
tbl
# Modify the cut-off point = 0.25:
heart_disease$predicted_CDH <- as.factor(ifelse(heart_disease$predicted_prob >= 0.25, 1, 0))
tbl <- table(heart_disease$CDH, heart_disease$predicted_CDH)
dimnames(tbl) <- list("Actual CDH" = levels(heart_disease$CDH),
"Predicted CDH" = levels(heart_disease$predicted_CDH))
tbl
model_ex2_glm <- glm(CDH ~ AGE_GRP + SMK + DBP + SBP + HPT, data = heart_disease, family = binomial(link = "logit"))
model_ex2_glm %>% tbl_regression(exponentiate = TRUE) %>%
add_glance_table(include = c(AIC, deviance))
model_ex2_glm <- glm(CDH ~ AGE_GRP + SMK + DBP, data = heart_disease, subset = (AGE_GRP != "50-60"), family = binomial(link = "logit"))
model_ex2_glm %>% tbl_regression(exponentiate = TRUE) %>%
add_glance_table(include = c(AIC, deviance))
library(tidyverse)
library(ggplot2)
library(gamlss)
composite <- readRDS("Bayley_Composite_scores.RDS")
GSV <- readRDS("Bayley_GSV_scores.RDS")
scaled <- readRDS("Bayley_Scaled_scores.RDS")
# create NEW data frames to not modify original sets, where "_p" indicates pivoted
composite_p <- data.frame(composite)
GSV_p <- data.frame(GSV)
scaled_p <- data.frame(scaled)
# Composite data pivoting
composite_p <- composite_p %>%
pivot_longer(cols = c(bsid_cog_composite, bsid_lang_composite, bsid_mot_composite), # columns to transform
names_to = "domains",
values_to = "Score_III") %>%
mutate(domains = recode(domains, # New names of incoming columns
bsid_cog_composite = "Cognitive",
bsid_lang_composite = "Language",
bsid_mot_composite = "Motor"))
shiny::runApp('~/Desktop/GitHub/eXtraordinarYBabiesStudy_ShinyApps/Jenna')
View(GSV_p)
