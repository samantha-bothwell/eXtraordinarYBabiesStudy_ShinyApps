data <- read_xlsx("~/Downloads/AMHinTSCopy1_combined.xlsx")
library(dplyr)
library(tidyr)
library(readr)
library(stringr)
library(ggplot2)
library(janitor)
library(broom)
library(lubridate)
library(readxl)
data <- read_xlsx("~/Downloads/AMHinTSCopy1_combined.xlsx")
View(data)
sum(!is.na(data$amh_result))
# data cleaning
data <- data %>%
group_by(record_id) %>%
fill(
karyotype_category_calc,
medhx_poi,
thelarche_yn,
thelarche_age,
thelarche_spont,
menarche_age,
menarche_spont,
.direction = "down"
) %>%
ungroup()
sum(!is.na(data$amh_result))
data <- data %>%
select(-redcap_repeat_instance)
data <- data %>% # getting rid of duplicates
distinct()
data <- data %>%
filter(
!is.na(amh_result) & amh_result != "", # limiting to those with an AMH
age_lab < 12 # limiting to AMH's prior to 12 years of age
)
sum(!is.na(data$amh_result))
data <- data %>%  # AMH as continuous
mutate(
amh_result_numeric = if_else(
str_detect(amh_result, "\\d"),  # contains a digit?
parse_number(amh_result),       # extract the number
NA))
sum(!is.na(data$amh_result_numeric))
data <- data %>% # FSH as continuous
mutate(
fsh_result_numeric = if_else(
str_detect(fsh_result, "\\d"),  # contains a digit?
parse_number(fsh_result),       # extract the number
NA))
data <- data %>% # thelarche category
mutate(
thelarche_spont = case_when(
thelarche_spont == 1 ~ "Yes",
thelarche_spont == 0 ~ "No",
is.na(thelarche_spont) ~ "Missing"
)
)
data <- data %>% # menarche category
mutate(
menarche_spont = case_when(
menarche_spont == 1 ~ "Yes",
menarche_spont == 0 ~ "No",
is.na(menarche_spont) ~ "Missing"
)
)
data <- data %>% # AMH as binary
mutate(
amh_binary = case_when(
str_detect(tolower(amh_result), "<") |
str_detect(tolower(amh_result), "less than") |
str_trim(amh_result) == "0" ~ "undetectable",
TRUE ~ "detectable"
)
)
data <- data %>%
mutate(
amh_cat = case_when(
amh_binary == "undetectable" ~ "undetectable",
amh_result_numeric > 1.0 ~ "normal",
TRUE ~ "low but detectable"
)
)
sum(!is.na(data$amh_cat))
data <- data %>%
mutate(
lab_date = as.Date(lab_date, format = "%m/%d/%y"),  # note lowercase %y for 2-digit year
time_elapsed = as.numeric(difftime(Sys.Date(), lab_date, units = "days")) / 365.25,
current_age = age_lab + time_elapsed
)
data <- data %>%
mutate(
fifteen = ifelse(current_age >12, 1, 0)
)
AMHinTS2 <- data %>%
select(record_id,	age_lab, lab_date, current_age,	amh_result,	amh_result_numeric,	amh_binary,	amh_cat, fsh_result,	fsh_result_numeric, lh_result,	thelarche_age,	thelarche_spont,	menarche_age,	menarche_spont)
sum(!is.na(AMHinTS2$amh_cat))
# Get one row per participant
data_unique <- data %>%
arrange(record_id) %>%
group_by(record_id) %>%
slice(1) %>%
ungroup()
# Create the contingency table
data_unique %>%
tabyl(amh_binary, menarche_spont) %>%
adorn_totals("row") %>%
adorn_percentages("row") %>%
adorn_pct_formatting(digits = 1) %>%
adorn_ns(position = "front")
data_unique %>%
tabyl(amh_binary, fifteen) %>%
adorn_totals("row") %>%
adorn_percentages("row") %>%
adorn_pct_formatting(digits = 1) %>%
adorn_ns(position = "front")
plot_data <- data %>%
filter(!is.na(amh_result_numeric)) %>%
mutate(
menarche_spont_group = case_when(
menarche_spont == "Yes" ~ "Yes",
menarche_spont == "No" ~ "No",
TRUE ~ "Missing"
)
)
sum(!is.na(plot_data$amh_result_numeric))
View(plot_data)
data_unique <- data %>%
arrange(record_id) %>%
group_by(record_id) %>%
slice(1) %>%
ungroup() %>%
filter(!is.na(amh_result_numeric), menarche_spont %in% c("Yes", "No"))
sum(!is.na(data_unique$amh_result_numeric))
View(data_unique)
View(data)
unique(data$record_id)
length(unique(data$record_id))
deployApp()
deployApp()
