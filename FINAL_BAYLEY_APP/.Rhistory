theme_gtsummary_compact() # set gtsummary theme
dat_1 <- read.csv("COSIBS2023_Homework_Data_LogisticRegression.csv")
#view(dat_1)
dat_1$Phys_activity <- as.factor(dat_1$Phys_activity)
mod1 <- glm(Depression ~ Binge_drink + Phys_activity + F_difficulties + Marijuana,
data = dat_1, family = binomial(link = "logit"))
summary(mod1)
exp(coef(mod1))
exp(confint(mod1))
dat_1$Transport = as.factor(dat_1$Transport)
mod2_f <- glm(Depression ~ BMI + F_difficulties + Transport, data = dat_1, family = binomial(link="logit"))
summary(mod2_f)
exp(coef(mod2_f))
exp(confint(mod2_f))
mod2_r <- glm(Depression ~ Transport, data = dat_1, family = binomial(link="logit"))
summary(mod2_r)
exp(coef(mod2_r))
exp(confint(mod2_r))
dev_mod2_f = 3012
dev_mod2_r = 3155
num_params_full = 6 # 1 from BMI + 1 from F_diff. + 3 from transport + intercept
num_params_red = 4 # 3 from transport + intercept
dev_diff <- dev_mod2_r - dev_mod2_r # 143
param_diff <- num_params_full - num_params_red # 2
pchisq(dev_diff, df = param_diff, lower.tail = FALSE)
dev_mod2_f = 3012
dev_mod2_r = 3155
num_params_full = 6 # 1 from BMI + 1 from F_diff. + 3 from transport + intercept
num_params_red = 4 # 3 from transport + intercept
dev_diff <- dev_mod2_r - dev_mod2_f # 143
param_diff <- num_params_full - num_params_red # 2
