## Libraries
library(tidyverse)
library(Hmisc)
## Dataset
dat <- read.csv("/Volumes/Shared/Shared Projects/Bothwell/Peds ENDO/SCA Studies/Developmental Milestones/Data/EXtraordinarYBabyStu-MilestonesRawData_DATA_2024-01-08_1541.csv")
## Dataset
dat <- read.csv("/Volumes/Shared/Shared Projects/Bothwell/Peds ENDO/SCA Studies/Developmental Milestones/Data/EXtraordinarYBabyS-MilestonesRawData_DATA_2024-01-08_1541.csv")
## Dataset
dat <- read.csv("/Volumes/Shared/Shared Projects/Bothwell/Peds ENDO/SCA Studies/Developmental Milestones/Data/EXtraordinarYBabiesS-MilestonesRawData_DATA_2024-01-08_1541.csv")
## Dataset
dat <- read.csv("/Volumes/Shared/Shared Projects/Bothwell/Peds ENDO/SCA Studies/Developmental Milestones/Data/EXtraordinarYBabiesS-MilestonesRawData_DATA_2026-01-08_1541.csv")
# Remove ID 1
dat <- dat[dat$study_id_extraordinary != "1",]
# Premature
premature <- dat %>%
## select columns
dplyr::select(study_id_extraordinary, birth_term_yn, gest_age) %>%
#filter out NA birth term
# filter(!is.na(birth_term_yn)) %>%
# Take out people who were premature
# filter(birth_term_yn == 1)
# filter to only gest_age > 36 wks
filter(gest_age > 37)
dat <- dat[dat$study_id_extraordinary %in% premature$study_id_extraordinary,]
## Make a demographics dataset
dems <- dat %>%
# Select needed variables
dplyr::select(study_id_extraordinary, redcap_event_name, sca_condition, age_today, earliest_income,
hollingshead_earliest, hollingshead_recent, quick_race, quick_ethnicity, ei_ever,
visit_date) %>%
# Calculate time in visit
mutate(visit_date = as.Date(visit_date, format = "%Y-%m-%d")) %>%
group_by(study_id_extraordinary) %>%
mutate(time_in_study = as.numeric((max(visit_date, na.rm = T) - min(visit_date, na.rm = T))/365)) %>%
ungroup() %>%
# Filter to only trisomies
filter(sca_condition %in% c(1, 2, 3)) %>%
# One row per person
filter(redcap_event_name == "enrollment_arm_1") %>%
# Recode variables
mutate(sca_condition = factor(sca_condition, levels = c(1, 2, 3), labels = c("XXY", "XYY", "XXX")),
age_today = age_today/12,
earliest_income = factor(earliest_income, levels = c(1:7),
labels = c("$50,000 or less", "$50,000 or less", "$50,000 - $100,000",
"$50,000 - $100,000", "$100,000 - $250,000", "$100,000 - $250,000",
"> $250,000")),
# moc_education = factor(moc_education, levels = c(1:7),
#                        labels = c("< 7th grade", "<= 9th grade", "<= 12th grade, no diploma", "HS Diploma",
#                                   "Partial college, at least 1 year, or specialized training",
#                                   "Standard University Degree", "Professional or Graduate Degree")),
# foc_education = factor(foc_education, levels = c(1:7),
#                        labels = c("< 7th grade", "<= 9th grade", "<= 12th grade, no diploma", "HS Diploma",
#                                   "Partial college, at least 1 year, or specialized training",
#                                   "Standard University Degree", "Professional or Graduate Degree")),
quick_race = factor(quick_race, levels = c(1:5, 7), labels = c("White", "Native Hawaiian or Other Pacific Islander",
"African American or Black", "Asian",
"Native American or Alaska Native", "Other")),
quick_ethnicity = ifelse(quick_ethnicity == 1, "Hispanic/Latinx", "Non-Hispanic/Latinx"),
ei_ever = ifelse(ei_ever == 1, "Yes", "No")) %>%
# Remove visit date
dplyr::select(-visit_date)
## Clean level of education
educ <- dat %>%
dplyr::select(study_id_extraordinary, redcap_event_name, contains("ses_parent")) %>%
filter(!is.na(ses_parent1_gender)) %>%
group_by(study_id_extraordinary) %>%
slice(1) %>%
mutate(ses_parent1_gender = ifelse(ses_parent1_gender == 1, "Dad", "Mom"),
ses_parent2_gender = ifelse(ses_parent2_gender == 1, "Dad", "Mom"),
ses_parent2_gender = ifelse(is.na(ses_parent2_gender) & ses_parent1_gender == "Mom", "Dad",
ifelse(is.na(ses_parent2_gender) & ses_parent1_gender == "Dad", "Mom", ses_parent2_gender)))
educ <- data.frame(study_id_extraordinary = c(educ$study_id_extraordinary, educ$study_id_extraordinary),
parent = c(educ$ses_parent1_gender, educ$ses_parent2_gender),
education = c(educ$ses_parent1_educ_level_new, educ$ses_parent2_educ_level_new))
educ <- educ %>%
pivot_wider(names_from = parent, values_from = education) %>%
mutate(Mom = factor(Mom, levels = c(1:7),
labels = c("Less than 7th grade", "9th grade or less",
"Partial high school, no diploma (12th grade or less)",
"High school graduate", "Partial college (at least one year) or specialized training",
"Standard college/University Graduation/Degree",
"Graduate/professional graduation/degree")),
Dad = factor(Dad, levels = c(1:7),
labels = c("Less than 7th grade", "9th grade or less",
"Partial high school, no diploma (12th grade or less)",
"High school graduate", "Partial college (at least one year) or specialized training",
"Standard college/University Graduation/Degree",
"Graduate/professional graduation/degree")))
dems$mom_education <- educ$Mom[match(dems$study_id_extraordinary, educ$study_id_extraordinary)]
dems$dad_education <- educ$Dad[match(dems$study_id_extraordinary, educ$study_id_extraordinary)]
## Assign labels
label(dems$age_today) <- "Age (Years; As of 7/9/2024)"
label(dems$earliest_income) <- "Earliest Documented Family Income"
label(dems$mom_education) <- "Mother's Highest Level of Education"
label(dems$dad_education) <- "Father's Highest Level of Education"
label(dems$hollingshead_earliest) <- "Earliest Hollingshead Index"
label(dems$hollingshead_recent) <- "Most Recent Hollingshead Index"
label(dems$quick_race) <- "Race"
label(dems$quick_ethnicity) <- "Ethnicity"
label(dems$ei_ever) <- "Ever Received EI"
label(dems$time_in_study) <- "Years in Study"
####### Discrepencies
dat_discrep <- dat %>%
filter(redcap_event_name != "enrollment_arm_1") %>%
filter(!is.na(devfu_sentences_age)) %>%
dplyr::select(study_id_extraordinary, redcap_event_name, devfu_sentences_age) %>%
group_by(study_id_extraordinary) %>%
filter(!(max(devfu_sentences_age, na.rm = T) == min(devfu_sentences_age, na.rm = T)))
write.csv(dat_discrep, "/Volumes/Shared/Shared Projects/Bothwell/Peds ENDO/SCA Studies/Developmental Milestones/Data/sentences_discrepencies.csv")
## Milestone ages
milestones <- dat %>%
# filter to only IDs that are in the dems dataset
filter(study_id_extraordinary %in% dems$study_id_extraordinary) %>%
# slice 1 obs per person
group_by(study_id_extraordinary) %>%
mutate(devfu_rolling_f2b_age = mean(devfu_rolling_f2b_age, na.rm = T),
devfu_rolling_b2f_age = mean(devfu_rolling_b2f_age, na.rm = T),
devfu_sit_age = mean(devfu_sit_age, na.rm = T),
devfu_coo_age = mean(devfu_coo_age, na.rm = T),
devfu_babble_age = mean(devfu_babble_age, na.rm = T),
devfu_singleword_age = mean(devfu_singleword_age, na.rm = T),
devfu_twoword_age = mean(devfu_twoword_age, na.rm = T),
devfu_sentences_age = mean(devfu_sentences_age, na.rm = T),
devfu_crawl_age = mean(devfu_crawl_age, na.rm = T),
devfu_cruise_age = mean(devfu_cruise_age, na.rm = T),
devfu_walk_age = mean(devfu_walk_age, na.rm = T),
devfu_run_age = mean(devfu_run_age, na.rm = T),
devfu_jump_age = mean(devfu_jump_age, na.rm = T)) %>%
ungroup() %>%
# get enrollment arm only
filter(redcap_event_name == "enrollment_arm_1") %>%
# pull only relevant columns
dplyr::select(study_id_extraordinary, sca_condition, contains("_age")) %>%
dplyr::select(-gest_age) %>%
# Recode SCA condition
mutate(sca_condition = factor(sca_condition, levels = c(1, 2, 3), labels = c("XXY", "XYY", "XXX")))
milestones_plot = milestones
label(milestones$devfu_rolling_f2b_age) <- "Rolling Front to Back"
label(milestones$devfu_rolling_b2f_age) <- "Rolling Back to Front"
label(milestones$devfu_sit_age) <- "Sitting"
label(milestones$devfu_crawl_age) <- "Crawling"
label(milestones$devfu_cruise_age) <- "Cruising"
label(milestones$devfu_walk_age) <- "Walking"
label(milestones$devfu_run_age) <- "Running"
label(milestones$devfu_jump_age) <- "Jumping"
label(milestones$devfu_coo_age) <- "Cooing"
label(milestones$devfu_babble_age) <- "Babbling"
label(milestones$devfu_singleword_age) <- "First Words"
label(milestones$devfu_twoword_age) <- "2 Word Phrases"
label(milestones$devfu_sentences_age) <- "Sentences"
View(milestones)
milestones[milestones == NaN] <- NA
View(milestones)
milestones[is.nan(milestones)] <- NA
milestones[milestones == "NaN"] <- NA
saveRDS("/Volumes/Shared/Shared Projects/Bothwell/Peds ENDO/SCA Studies/Developmental Milestones/Data/Milestones.RDS")
saveRDS(milestones, "/Volumes/Shared/Shared Projects/Bothwell/Peds ENDO/SCA Studies/Developmental Milestones/Data/Milestones.RDS")
Milestones <- readRDS("/Volumes/Shared/Shared Projects/Bothwell/Peds ENDO/SCA Studies/eXtraordinarYBabiesStudy_ShinyApps/Bayley_and_Milestone_Progression/Milestones.RDS")
View(Milestones)
shiny::runApp()
milestones_sum <- Milestones %>% group_by(sca_condition) %>% summarise(N = n())
# Add proportions and cumulative positions for the labels
milestones_sum$fraction <- milestones_sum$N / sum(milestones_sum$N)
milestones_sum$ymax <- cumsum(milestones_sum$fraction)
milestones_sum$ymin <- c(0, head(milestones_sum$ymax, n = -1))
milestones_sum$label_position <- (milestones_sum$ymax + milestones_sum$ymin) / 2
milestones_sum$label <- paste0(milestones_sum$sca_condition, "\n(N = ", milestones_sum$N, ")")
# Plot
ggplot(milestones_sum, aes(ymax = ymax, ymin = ymin, xmax = 4, xmin = 2.65, fill = sca_condition)) +
geom_rect(alpha = 0.7) +
geom_text(aes(x = 3.35, y = label_position, label = label), color = "black", size = 5.6) +
coord_polar(theta = "y") +
xlim(c(2, 4)) +
theme_void() +
theme(legend.position = "none") +
labs(title = "Donut Plot of SCA Conditions") +
scale_fill_manual(values = c("#4B0082", "#fdb863", "cyan3"))
